#!/usr/bin/env bash
# oc-chat: talk to an opencode session like a chat, printing only user/assistant text.
# Usage: oc-chat [-C dir] <session id | title substring> [--tail N|all] [--since N] [--full] [message...]
#   message      send it, wait for the run to finish, print everything after it
#   message      send it to the session, wait for the run to finish, then print everything after it was sent
#   --since N    print messages numbered > N (use the "last=#N" from the previous call so nothing is skipped)
#   --tail N|all print the last N messages (default 5 when only reading), or the whole chat
#   --full       also show reasoning and tool calls (truncated)
set -euo pipefail
dir="$PWD"; tail=""; since=""; full=0; sess=""; msg=()
while [ $# -gt 0 ]; do
  case "$1" in
    -C) dir="$2"; shift 2;;
    --tail) tail="$2"; shift 2;;
    --since) since="$2"; shift 2;;
    --full) full=1; shift;;
    -h|--help) sed -n 2,8p "$0"; exit 0;;
    *) if [ -z "$sess" ]; then sess="$1"; else msg+=("$1"); fi; shift;;
  esac
done
[ -n "$sess" ] || { echo "need a session id or title" >&2; exit 2; }
cd "$dir"
if [[ "$sess" != ses_* ]]; then
  id=$(opencode session list 2>/dev/null | grep -iF -- "$sess" | head -1 | cut -f1)
  [ -n "$id" ] || { echo "no session matching '$sess' in $dir" >&2; exit 1; }
  sess="$id"
fi
tmp=$(mktemp); trap 'rm -f "$tmp"' EXIT
export_count() { opencode session export "$sess" >"$tmp" 2>/dev/null; jq '.messages|length' "$tmp"; }
if [ ${#msg[@]} -gt 0 ]; then
  before=$(export_count)
  [ -n "$since" ] || since="$before"
  opencode run --session "$sess" "${msg[*]}" >/dev/null 2>&1 || echo "(opencode run exited with an error; showing what was recorded)" >&2
fi
opencode session export "$sess" >"$tmp" 2>/dev/null
total=$(jq '.messages|length' "$tmp")
if [ -n "$since" ]; then start="$since"
elif [ "$tail" = "all" ]; then start=0
else start=$(( total - ${tail:-5} )); [ "$start" -lt 0 ] && start=0; fi
jq -r --argjson start "$start" --argjson full "$full" '
  .messages | to_entries[] | select(.key >= $start) | .key as $k | .value as $m
  | if $m.type == "user" then
      ($m.text // "") as $t | select($t != "") | "#\($k+1) [user]\n\($t)\n"
    elif $m.type == "assistant" then
      ([$m.content[]? |
        if .type == "text" then .text
        elif $full == 1 and .type == "reasoning" then "(thinking) " + ((.text // "")[0:300])
        elif $full == 1 and .type == "tool" then "(tool) " + ((.tool // .name // "") | tostring) + " " + ((.input // .state.input // {} | tostring)[0:200])
        else empty end] | map(select(. != "")) | join("\n")) as $t
      | select($t != "") | "#\($k+1) [assistant]\n\($t)\n"
    else empty end' "$tmp"
echo "last=#$total session=$sess"
